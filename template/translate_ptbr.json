{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "newsletter": {
      "type": "string",
      "description": "A concise SEO title (5-10 words) reflecting core themes of the content.",
      "minLength": 25,
      "maxLength": 85
    },
    "summary": {
      "type": "string",
      "description": "A concise summary (35-50 words) capturing central ideas of the content.",
      "minLength": 250,
      "maxLength": 400
    },
    "overview": {
      "type": "string",
      "description": "An extended business context (150-250 words) with key takeaways and recommendations.",
      "minLength": 700,
      "maxLength": 1500
    },
    "key_points": {
      "type": "array",
      "description": "Up to 5 significant and distinct points from the content.",
      "items": {
        "type": "string"
      },
      "minItems": 0,
      "maxItems": 5
    },
    "classification": {
      "type": "array",
      "description": "Applicable categories: Business, Technological, Scientific, Others.",
      "items": {
        "type": "string",
        "enum": ["Negócios", "Tecnológico", "Científico", "Outros"]
      },
      "minItems": 0,
      "maxItems": 4
    },
    "classification_weight": {
      "type": "object",
      "description": "Numeric scores reflecting prominence of each category.",
      "properties": {
        "Negócios": {
          "type": "integer",
          "minimum": 0,
          "maximum": 35
        },
        "Tecnológico": {
          "type": "integer",
          "minimum": 0,
          "maximum": 35
        },
        "Científico": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "Outros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        }
      },
      "required": ["Negócios", "Tecnológico", "Científico", "Outros"],
      "additionalProperties": false
    },
    "organization": {
      "type": "array",
      "description": "List of named organizations (companies, universities, etc.).",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Full name of the event.",
            "minLength": 3,
            "maxLength": 150
          },
          "location": {
            "type": "string",
            "description": "Organization location as 'City, Country' or 'Country'.",
            "minLength": 3,
            "maxLength": 50
          }
        },
        "required": ["name", "location"],
        "additionalProperties": false
      },
      "minItems": 0
    },	
    "event": {
      "type": "array",
      "description": "Details of named conferences, forums, summits, or congresses.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Full name of the event."
          },
          "location": {
            "type": "string",
            "description": "Event location as 'City, Country' or 'Online, Global' for online events."
          },
          "type": {
            "type": "string",
            "enum": ["Fórum", "Conferência", "Workshop", "Exposição", "Casa Aberta", "Hackathon", "Simpósio", "Evento Híbrido", "Conferência Online", "Série de Palestrantes", "Exibição de Filme", "Discussão em Painel", "Evento", "Webinar", "n/a"],
            "description": "Type of event."
          },
          "description": {
            "type": "string",
            "description": "Concise description of the event’s purpose (20-50 words).",
            "minLength": 150,
            "maxLength": 400
          }
        },
        "required": ["name", "location", "type", "description"],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "breakthrough": {
      "type": "array",
      "description": "Descriptions of new products, technologies, platforms, or services.",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "financial_activity": {
      "type": "array",
